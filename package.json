{
  "name": "tecnitium",
  "version": "1.0.0",
  "private": true,
  "description": "Tecnitium - sistema para assistencia tecnica (React, dados no navegador; /api/email na Vercel para enviar e-mails)",
  "workspaces": [
    "shared",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web && node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});fs.cpSync('web/dist','dist',{recursive:true})\"",
    "preview": "npm run preview -w web"
  },
  "dependencies": {
    "nodemailer": "^6.9.16"
  }
}
