// Tecnitium - sistema para assistencia tecnica
// Datas gravadas como texto "AAAA-MM-DD" (ou "AAAA-MM-DDTHH:MM" em data e hora).
// Para PostgreSQL, troque o provider para "postgresql" e ajuste DATABASE_URL no .env.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Usuario {
  id          String   @id @default(cuid())
  nome        String
  email       String   @unique
  senhaHash   String
  perfil      String   @default("ATENDENTE") // ADMIN | ATENDENTE | TECNICO
  tecnicoId   String?  // vinculo do login com o cadastro do tecnico
  atendenteId String?  // vinculo do login com o cadastro do atendente
  ativo       Boolean  @default(true)
  criadoEm    DateTime @default(now())
}

model Configuracao {
  id               Int     @id @default(1)
  nomeEmpresa      String  @default("Tecnitium Assistência Técnica")
  documento        String?
  telefone         String?
  whatsapp         String?
  endereco         String?
  prazoPadraoDias  Int     @default(3)
  garantiaDias     Int     @default(90)
  diasAbandono     Int     @default(30) // aparelho pronto sem retirada
  baseComissaoPeca String  @default("Venda") // Venda | Lucro
  termos           String?
}

model Cliente {
  id        String  @id @default(cuid())
  nome      String
  documento String?
  telefone  String?
  whatsapp  String?
  email     String?
  cep       String?
  endereco  String?
  cidade    String?
  uf        String?
  obs       String?
  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model Aparelho {
  id         String  @id @default(cuid())
  clienteId  String
  tipo       String
  marca      String
  modelo     String
  serie      String? // IMEI ou numero de serie
  cor        String?
  senha      String? // senha ou padrao de desbloqueio
  acessorios String?
  obs        String?
  criadoEm   DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model Tecnico {
  id           String  @id @default(cuid())
  nome         String
  cpf          String?
  telefone     String?
  email        String?
  especialidade String?
  regime       String  @default("Comissão") // Comissão | Salário fixo
  salario      Float   @default(0)
  percPeca     Float   @default(0)
  percServico  Float   @default(0)
  ativo        Boolean @default(true)
  obs          String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model Atendente {
  id        String  @id @default(cuid())
  nome      String
  cpf       String?
  telefone  String?
  email     String?
  ativo     Boolean @default(true)
  obs       String?
  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model Peca {
  id            String  @id @default(cuid())
  codigo        String  @unique
  descricao     String
  categoria     String?
  marca         String?
  compatibilidade String?
  unidade       String  @default("un")
  quantidade    Float   @default(0)
  minimo        Float   @default(0)
  custo         Float   @default(0)
  preco         Float   @default(0)
  localizacao   String?
  ativo         Boolean @default(true)
  obs           String?
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt
}

model MovEstoque {
  id         String  @id @default(cuid())
  pecaId     String
  data       String
  tipo       String  // Entrada | Saída | Ajuste | Saída OS | Devolução OS
  quantidade Float   // positivo entra, negativo sai
  custoUnit  Float?
  origem     String? // fornecedor, nota fiscal, motivo
  osId       String?
  automatico Boolean @default(false)
  obs        String?
  criadoEm   DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model OrdemServico {
  id              String  @id @default(cuid())
  numero          Int     @unique
  clienteId       String
  aparelhoId      String
  atendenteId     String?
  tecnicoId       String?
  entrada         String
  prazo           String?
  prioridade      String  @default("Normal") // Normal | Urgente
  status          String  @default("Aberta")
  defeito         String
  estado          String? // condicoes do aparelho na entrada
  acessorios      String?
  diagnostico     String?
  servicoExecutado String?
  itens           String  @default("[]") // JSON: [{tipo, pecaId, desc, qtd, valor, custo}]
  desconto        Float   @default(0)
  valorPago       Float   @default(0)
  formaPagamento  String?
  garantiaDias    Int?
  dataPronta      String?
  dataEntrega     String?
  retiradoPor     String?
  regime          String? // snapshot do tecnico na entrega
  percPeca        Float?
  percServico     Float?
  comissaoPeca    Float   @default(0)
  comissaoServico Float   @default(0)
  obs             String?
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt
}

model FotoOS {
  id       String   @id @default(cuid())
  osId     String
  arquivo  String
  legenda  String?
  criadoEm DateTime @default(now())
}
